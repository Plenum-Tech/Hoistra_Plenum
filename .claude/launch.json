{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/frontend"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "frontend-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/frontend",
        "--",
        "--mode",
        "verify",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "schema-mapper-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/backend/cafm-connector-service-final/svc-ai-schema-mapper-ui",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "plenum-cafm-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "C:/CMMS/Plenum-CAFM/apps/frontend"
      ],
      "port": 3000
    },
    {
      "name": "frontend-tracelab",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_TRACE_LAB=1 && npm run dev --prefix apps/frontend -- --port 5176 --strictPort"
      ],
      "port": 5176
    }
  ]
}
