# Copy to `.env` in this directory. `docker compose` reads it for ${VAR} interpolation in
# docker-compose.single-url.local.yml. This is NOT a container env_file — that is
# apps/backend/.env (copy from apps/backend/.env.example).

# Feature flags for svc-deepagents (1 = on). Remove a line to fall back to the old path.
ORCHESTRATOR_LLM_ROUTING=1
COMPLIANCE_SKILL_PATH=1
COMPLIANCE_SELECTIVE_SKILLS=1

# Postgres DSN shared by every backend service (asyncpg). Compose appends ?sslmode=require
# for the services that need it.
PLENUM_DB_DSN=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Optional tenant scope baked into the frontend build (empty = backend default organisation).
VITE_ORGANIZATION_ID=

# ── Authentication (svc-operations-intelligence) ────────────────────────────────────
#
# Both are REQUIRED in production and staging: the service refuses to start without them,
# on purpose. A default value shipped in a file like this one is the same secret in every
# deployment that forgot to change it, and anyone holding it can mint a token for any
# account with nothing in the logs to tell those tokens from real ones.
#
# In development, leaving them empty generates a fresh one per process — which signs
# everybody out on every restart, which is annoying exactly often enough to get noticed.
#
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Signs access tokens. Rotating it ends every session immediately.
AUTH_JWT_SECRET=
# Keys the hash of one-time codes. Deliberately separate from the signing key, so
# disclosure of one does not hand over the other and either can be rotated alone.
AUTH_OTP_PEPPER=

# Which organisation a self-registered account joins. Leave empty where the deployment
# has exactly one — registration then uses it, and refuses to guess where there are more.
AUTH_DEFAULT_ORGANIZATION_ID=
# Open sign-up. false = accounts can only be created by an existing operator.
AUTH_ALLOW_SELF_REGISTRATION=true

# Roles are superadmin | admin | user. Self-registration always creates "user" (a
# facilities manager) — an endpoint that took the role from the request body would be an
# endpoint where anyone registers as an administrator.
#
# The chicken-and-egg: only a superadmin can appoint a superadmin, and a new platform has
# none. The FIRST account registered with the address below becomes one, and only while
# the platform still has no superadmin — so setting it later, or leaving it set
# afterwards, grants nothing. The address is confirmed by email like any other, so this
# does not hand the platform to whoever types it first; they have to hold the mailbox.
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=

# Defaults shown; every one is optional.
# AUTH_ACCESS_TOKEN_TTL_MINUTES=30      short — an access token cannot be revoked
# AUTH_REFRESH_TOKEN_TTL_DAYS=14        long — a refresh token is a row, and can be
# AUTH_OTP_TTL_MINUTES=10
# AUTH_OTP_MAX_ATTEMPTS=5               six digits is a million; five guesses is none
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_OTP_MAX_PER_HOUR=5
# AUTH_PASSWORD_MIN_LENGTH=12
# AUTH_LOGIN_MAX_FAILURES=8
# AUTH_LOCKOUT_MINUTES=15

# NOTE: OTP emails go out through the same sender as everything else, so EMAIL_DRY_RUN
# must be false (with Graph or SMTP credentials set) for codes to actually be delivered.
# With it true the flow works end to end and every code is written only to the log as
# "[code redacted]" — nobody can sign up.
