# Copy to `.env` in this directory. `docker compose` reads it for ${VAR} interpolation in
# docker-compose.single-url.local.yml. This is NOT a container env_file — that is
# apps/backend/.env (copy from apps/backend/.env.example).

# Feature flags for svc-deepagents (1 = on). Remove a line to fall back to the old path.
ORCHESTRATOR_LLM_ROUTING=1
COMPLIANCE_SKILL_PATH=1
COMPLIANCE_SELECTIVE_SKILLS=1

# Postgres DSN shared by every backend service (asyncpg). Compose appends ?sslmode=require
# for the services that need it.
PLENUM_DB_DSN=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Optional tenant scope baked into the frontend build (empty = backend default organisation).
VITE_ORGANIZATION_ID=
