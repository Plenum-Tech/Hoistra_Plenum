# dependencies / builds
node_modules/
dist/
.next/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# local secrets — every one of these has a committed *.example
.env
.env.local
.env.*.local
apps/backend/.env
apps/frontend/.env.local
# Copies of an env file carry the same secrets as the original and are missed by the
# rules above, which match exact names. 23 Sep 2026: two .env.local.bak-* files sat
# untracked-but-committable in a public repo holding an Anthropic key and an Azure
# client secret.
.env*.bak*
*.env.bak*
apps/backend/config.toml

# tooling
.DS_Store
*.log
.idea/
.vscode/
graphify-out/
# local plugin working state — config + a hook cache, regenerated on demand
.impeccable/

# PR description drafts. Written to be pasted into a pull request, where the audience is
# people who already have repo access — not into public git history. The current one names
# the credentials that are readable in the container environment and still unrotated, and
# this repository is public, so committing it would confirm in permanent history exactly
# which live secrets to go looking for.
PR_BODY.md
